# Copy to .env.social (git-ignored) and fill in. Never commit real tokens.

# Safety switch: without it every social_publish call is a dry run.
GROWTHOS_ALLOW_PUBLISH=0

# Telegram — @BotFather token; bot must be an admin of the channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@your_channel

# Meta — app in Development mode, yourself added as tester
META_GRAPH_VERSION=
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRAPH_HOST=graph.instagram.com
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# X — OAuth 2.0 public client; get the refresh token with:
#   python -m growthos.scripts.social_auth x
X_CLIENT_ID=
X_REFRESH_TOKEN=

# YouTube — Google Cloud OAuth client "Desktop app"; refresh token via:
#   python -m growthos.scripts.social_auth youtube
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PROJECT_AUDITED=0

# TikTok — inbox (draft) mode works without audit
TIKTOK_ACCESS_TOKEN=
TIKTOK_MODE=inbox
